# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# CORS — comma-separated, no trailing slashes.
# Arch: createch.co.ke + local Vite/Next. Hobbies Vercel origins kept so
# existing order/payment frontends keep working.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://createch.co.ke,https://www.createch.co.ke,https://createatechhobbies1.vercel.app,https://createchhobbies.vercel.app

# Admin
ADMIN_API_KEY=choose-a-strong-random-string
ADMIN_SECRET_KEY=generate-with-python-secrets-token-urlsafe-32

# Arch image library — X-Admin-Key on POST/PATCH/DELETE/reorder and PUT chrome.
# If unset, ADMIN_SECRET_KEY is accepted.
ARCH_ADMIN_SECRET=generate-with-python-secrets-token-urlsafe-32
ARCH_MAX_UPLOAD_BYTES=12582912

# Media storage (image BYTES — never in Postgres BYTEA)
# Local / Railway volume (default):
#   1. Add a Railway volume and mount it at /data
#   2. Set MEDIA_ROOT=/data/media
#   3. Set SERVE_MEDIA=True so gunicorn serves /media/ from that volume
# Dev: files land in ./media and are served automatically when DEBUG=True.
MEDIA_ROOT=media
MEDIA_URL=/media/
SERVE_MEDIA=False

# Optional S3 / Cloudflare R2 (django-storages). If AWS_STORAGE_BUCKET_NAME is
# set, local MEDIA_ROOT is unused for uploads. Bucket should allow public read
# of arch/* (or set AWS_S3_CUSTOM_DOMAIN to a public CDN/R2.dev hostname).
# AWS_STORAGE_BUCKET_NAME=arch-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_QUERYSTRING_AUTH=False

# Upload an Arch image:
#   curl -X POST https://<railway-host>/api/arch/images/ \
#     -H "X-Admin-Key: $ARCH_ADMIN_SECRET" \
#     -F "file=@photo.jpg" \
#     -F "alt=Hero courtyard" \
#     -F "slot=hero" \
#     -F "title=Courtyard"
# List (public):
#   curl https://<railway-host>/api/arch/images/
# Patch metadata:
#   curl -X PATCH https://<railway-host>/api/arch/images/<uuid>/ \
#     -H "X-Admin-Key: $ARCH_ADMIN_SECRET" -H "Content-Type: application/json" \
#     -d '{"alt":"Updated","sort_order":2,"slot":"gallery"}'
# Reorder:
#   curl -X PUT https://<railway-host>/api/arch/images/reorder/ \
#     -H "X-Admin-Key: $ARCH_ADMIN_SECRET" -H "Content-Type: application/json" \
#     -d '[{"id":"<uuid>","sort_order":1,"slot":"hero"}]'
# Chrome:
#   curl https://<railway-host>/api/arch/chrome/
#   curl -X PUT https://<railway-host>/api/arch/chrome/ \
#     -H "X-Admin-Key: $ARCH_ADMIN_SECRET" -H "Content-Type: application/json" \
#     -d '{"nav":{"label":"Work"}}'

# M-Pesa is handled by the WooCommerce STK Push plugin on WordPress,
# not by this backend. (Daraja app removed 2026-07.)

# WooCommerce order-mirror webhook — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and paste the same value into the Woo webhook's Secret field
WOO_WEBHOOK_SECRET=generate-a-strong-random-string

# DPO Pay — get credentials from the DPO merchant portal
DPO_COMPANY_TOKEN=your-dpo-company-token
DPO_SERVICE_ID=your-dpo-service-id
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAYMENT_URL=https://secure.3gdirectpay.com/payv2.php
DPO_TEST_MODE=True
